//@version=6
indicator("OlympTrade Binary Signal Tool [Premium]", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// ==========================================
// INPUTS
// ==========================================

// --- Sessions ---
useSessionFilter = input.bool(true, "Use Session Filter", group="Sessions")
sessionLondon = input.session("0800-1600", "London Session", group="Sessions")
sessionNY = input.session("1300-2100", "New York Session", group="Sessions")

// --- Trend Analysis ---
ema5Len = input.int(5, "EMA 5 Length", group="Trend")
ema20Len = input.int(20, "EMA 20 Length", group="Trend")
ema50Len = input.int(50, "EMA 50 Length", group="Trend")
ema200Len = input.int(200, "EMA 200 Length", group="Trend")

stMult = input.float(3.0, "SuperTrend Multiplier", group="Trend")
stPeriod = input.int(10, "SuperTrend Period", group="Trend")

adxLen = input.int(14, "ADX Length", group="Trend")
adxThreshold = input.int(25, "ADX Strength Threshold", group="Trend")

// --- Momentum Analysis ---
rsiLen = input.int(14, "RSI Length", group="Momentum")
stochK = input.int(14, "Stoch K", group="Momentum")
stochD = input.int(3, "Stoch D", group="Momentum")
stochSmooth = input.int(3, "Stoch Smooth", group="Momentum")

macdFast = input.int(12, "MACD Fast", group="Momentum")
macdSlow = input.int(26, "MACD Slow", group="Momentum")
macdSignal = input.int(9, "MACD Signal", group="Momentum")

cciLen = input.int(20, "CCI Length", group="Momentum")
wprLen = input.int(14, "Williams %R Length", group="Momentum")

// --- Volatility ---
bbLen = input.int(20, "Bollinger Bands Length", group="Volatility")
bbMult = input.float(2.0, "Bollinger Bands Mult", group="Volatility")
atrLen = input.int(14, "ATR Length", group="Volatility")
kcLen = input.int(20, "Keltner Channel Length", group="Volatility")
kcMult = input.float(1.5, "Keltner Channel Mult", group="Volatility")

// --- AI Scoring Weights ---
weightTrend = input.float(25, "Trend Weight %", minval=0, maxval=100, group="AI Engine") / 100
weightMomentum = input.float(25, "Momentum Weight %", minval=0, maxval=100, group="AI Engine") / 100
weightSMC = input.float(20, "SMC Weight %", minval=0, maxval=100, group="AI Engine") / 100
weightVolume = input.float(15, "Volume Weight %", minval=0, maxval=100, group="AI Engine") / 100
weightSR = input.float(15, "S/R Weight %", minval=0, maxval=100, group="AI Engine") / 100

minConfidence = input.float(85.0, "Min Confidence % for Signal", group="AI Engine")

// ==========================================
// CALCULATIONS - Trend Analysis
// ==========================================

ema5 = ta.ema(close, ema5Len)
ema20 = ta.ema(close, ema20Len)
ema50 = ta.ema(close, ema50Len)
ema200 = ta.ema(close, ema200Len)

[stValue, stDirection] = ta.supertrend(stMult, stPeriod)
stBullish = stDirection < 0

[diplus, diminus, adx] = ta.dmi(adxLen, adxLen)
adxStrong = adx > adxThreshold

// ==========================================
// CALCULATIONS - Momentum Analysis
// ==========================================

rsi = ta.rsi(close, rsiLen)
stochKVal = ta.sma(ta.stoch(close, high, low, stochK), stochSmooth)
stochDVal = ta.sma(stochKVal, stochD)

[macdLine, signalLine, _] = ta.macd(close, macdFast, macdSlow, macdSignal)
cci = ta.cci(close, cciLen)
wpr = ta.wpr(wprLen)

// ==========================================
// CALCULATIONS - Volatility
// ==========================================

[bbUpper, bbMiddle, bbLower] = ta.bb(close, bbLen, bbMult)
atr = ta.atr(atrLen)
[kcUpper, kcMiddle, kcLower] = ta.kc(close, kcLen, kcMult)

// ==========================================
// CALCULATIONS - Volume
// ==========================================

volAvg = ta.sma(volume, 20)
volSpike = volume > volAvg * 1.5
volBullish = close > open and volume > volAvg
volBearish = close < open and volume > volAvg

// ==========================================
// CALCULATIONS - Smart Money Concepts (SMC)
// ==========================================

// --- Pivot Points ---
var int leftBars = 5
var int rightBars = 5
pivotHigh = ta.pivothigh(high, leftBars, rightBars)
pivotLow = ta.pivotlow(low, leftBars, rightBars)

var float lastPivotHigh = na
var float lastPivotLow = na
var bool bosBullish = false
var bool bosBearish = false
var bool chochBullish = false
var bool chochBearish = false

// CHOCH logic (Change of Character): first break of opposite structure
var bool trendIsBullish = true

if not na(pivotHigh)
    if high[rightBars] > lastPivotHigh
        if trendIsBullish == false
            chochBullish := true
            trendIsBullish := true
            bosBullish := false
        else
            bosBullish := true
            chochBullish := false
    else
        bosBullish := false
        chochBullish := false
    lastPivotHigh := high[rightBars]

if not na(pivotLow)
    if low[rightBars] < lastPivotLow
        if trendIsBullish == true
            chochBearish := true
            trendIsBullish := false
            bosBearish := false
        else
            bosBearish := true
            chochBearish := false
    else
        bosBearish := false
        chochBearish := false
    lastPivotLow := low[rightBars]

// --- Liquidity Sweep ---
liqSweepBull = low < ta.lowest(low, 20)[1] and close > ta.lowest(low, 20)[1]
liqSweepBear = high > ta.highest(high, 20)[1] and close < ta.highest(high, 20)[1]

// --- Order Blocks (Simplified) ---
isOBBullish = close[1] < open[1] and close > high[1] and volume > volAvg
isOBBearish = close[1] > open[1] and close < low[1] and volume > volAvg

// --- Fair Value Gaps (FVG) ---
fvgBullish = low > high[2] and close[1] > high[2]
fvgBearish = high < low[2] and close[1] < low[2]

// --- Dynamic Support & Resistance ---
highRes = ta.highest(high, 50)
lowSup = ta.lowest(low, 50)
nearSupport = close <= lowSup * 1.01
nearResistance = close >= highRes * 0.99

// ==========================================
// AI SCORING ENGINE
// ==========================================

// --- Trend Score (25%) ---
trendScore = 0.0
trendScore += (close > ema200 ? 5.0 : 0.0)
trendScore += (ema20 > ema50 ? 5.0 : 0.0)
trendScore += (stBullish ? 10.0 : 0.0)
trendScore += (adxStrong ? 5.0 : 0.0)
trendScoreBear = 0.0
trendScoreBear += (close < ema200 ? 5.0 : 0.0)
trendScoreBear += (ema20 < ema50 ? 5.0 : 0.0)
trendScoreBear += (not stBullish ? 10.0 : 0.0)
trendScoreBear += (adxStrong ? 5.0 : 0.0)

// --- Momentum Score (25%) ---
momScore = 0.0
momScore += (rsi > 50 ? 5.0 : 0.0)
momScore += (stochKVal > stochDVal ? 5.0 : 0.0)
momScore += (macdLine > signalLine ? 5.0 : 0.0)
momScore += (cci > 0 ? 5.0 : 0.0)
momScore += (wpr > -50 ? 5.0 : 0.0)
momScoreBear = 0.0
momScoreBear += (rsi < 50 ? 5.0 : 0.0)
momScoreBear += (stochKVal < stochDVal ? 5.0 : 0.0)
momScoreBear += (macdLine < signalLine ? 5.0 : 0.0)
momScoreBear += (cci < 0 ? 5.0 : 0.0)
momScoreBear += (wpr < -50 ? 5.0 : 0.0)

// --- SMC Score (20%) ---
smcScore = 0.0
smcScore += (bosBullish ? 5.0 : 0.0)
smcScore += (chochBullish ? 5.0 : 0.0)
smcScore += (liqSweepBull ? 5.0 : 0.0)
smcScore += (isOBBullish ? 2.5 : 0.0)
smcScore += (fvgBullish ? 2.5 : 0.0)
smcScoreBear = 0.0
smcScoreBear += (bosBearish ? 5.0 : 0.0)
smcScoreBear += (chochBearish ? 5.0 : 0.0)
smcScoreBear += (liqSweepBear ? 5.0 : 0.0)
smcScoreBear += (isOBBearish ? 2.5 : 0.0)
smcScoreBear += (fvgBearish ? 2.5 : 0.0)

// --- Volume Score (15%) ---
volScore = 0.0
volScore += (volBullish ? 10.0 : 0.0)
volScore += (volSpike ? 5.0 : 0.0)
volScoreBear = 0.0
volScoreBear += (volBearish ? 10.0 : 0.0)
volScoreBear += (volSpike ? 5.0 : 0.0)

// --- Support/Resistance Score (15%) ---
srScore = 0.0
srScore += (nearSupport ? 15.0 : 0.0)
srScoreBear = 0.0
srScoreBear += (nearResistance ? 15.0 : 0.0)

// --- Final AI Confidence Score ---
totalScoreBull = (trendScore * (weightTrend/0.25)) + (momScore * (weightMomentum/0.25)) + (smcScore * (weightSMC/0.20)) + (volScore * (weightVolume/0.15)) + (srScore * (weightSR/0.15))
totalScoreBear = (trendScoreBear * (weightTrend/0.25)) + (momScoreBear * (weightMomentum/0.25)) + (smcScoreBear * (weightSMC/0.20)) + (volScoreBear * (weightVolume/0.15)) + (srScoreBear * (weightSR/0.15))

// Normalize to 100%
confidenceBull = math.min(100.0, totalScoreBull)
confidenceBear = math.min(100.0, totalScoreBear)

// ==========================================
// SESSION & MARKET FILTERS
// ==========================================

isLondon = not na(time(timeframe.period, sessionLondon + ":1234567"))
isNY = not na(time(timeframe.period, sessionNY + ":1234567"))
inSession = not useSessionFilter or isLondon or isNY

// Restricted Pairs Check
isMajorPair = syminfo.ticker == "EURUSD" or syminfo.ticker == "GBPUSD" or syminfo.ticker == "USDJPY" or syminfo.ticker == "USDCHF" or syminfo.ticker == "AUDUSD" or syminfo.ticker == "USDCAD" or syminfo.ticker == "NZDUSD"
isCrossPair = syminfo.ticker == "EURJPY" or syminfo.ticker == "GBPJPY" or syminfo.ticker == "EURGBP" or syminfo.ticker == "AUDJPY" or syminfo.ticker == "EURAUD" or syminfo.ticker == "GBPAUD"
isValidPair = isMajorPair or isCrossPair

// Timeframe restriction (1m, 2m, 5m)
isValidTimeframe = timeframe.isintraday and (timeframe.multiplier == 1 or timeframe.multiplier == 2 or timeframe.multiplier == 5)

// ==========================================
// SIGNAL GENERATION
// ==========================================

canTrade = inSession and isValidPair and isValidTimeframe and adxStrong and volume > volAvg

isCall = canTrade and confidenceBull >= minConfidence and stBullish and close > ema200
isPut = canTrade and confidenceBear >= minConfidence and not stBullish and close < ema200

// ==========================================
// VISUALIZATIONS
// ==========================================

// --- Signals ---
plotshape(isCall, title="CALL Signal", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, text="CALL")
plotshape(isPut, title="PUT Signal", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="PUT")

// --- Dashboard ---
var table dashboard = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 70), border_width=1)
if barstate.islast
    table.cell(dashboard, 0, 0, "Metric", text_color=color.white)
    table.cell(dashboard, 1, 0, "Value", text_color=color.white)

    table.cell(dashboard, 0, 1, "Bullish Conf.", text_color=color.white)
    table.cell(dashboard, 1, 1, str.tostring(confidenceBull, "#.##") + "%", text_color=confidenceBull > 80 ? color.green : color.white)

    table.cell(dashboard, 0, 2, "Bearish Conf.", text_color=color.white)
    table.cell(dashboard, 1, 2, str.tostring(confidenceBear, "#.##") + "%", text_color=confidenceBear > 80 ? color.red : color.white)

    table.cell(dashboard, 0, 3, "Trend", text_color=color.white)
    table.cell(dashboard, 1, 3, stBullish ? "Bullish" : "Bearish", text_color=stBullish ? color.green : color.red)

    table.cell(dashboard, 0, 4, "Volatility", text_color=color.white)
    table.cell(dashboard, 1, 4, close > bbUpper or close < bbLower ? "High" : "Low", text_color=color.aqua)

    table.cell(dashboard, 0, 5, "Session", text_color=color.white)
    table.cell(dashboard, 1, 5, inSession ? "Active" : "Closed", text_color=inSession ? color.green : color.gray)

// --- Zones ---
// S/R Zones
var box supBox = na
var box resBox = na
if barstate.islast
    supBox := box.new(bar_index[50], lowSup * 1.001, bar_index, lowSup * 0.999, color.new(color.green, 80), bgcolor=color.new(color.green, 90))
    resBox := box.new(bar_index[50], highRes * 1.001, bar_index, highRes * 0.999, color.new(color.red, 80), bgcolor=color.new(color.red, 90))
    box.delete(supBox[1])
    box.delete(resBox[1])

// FVG Zones (Last FVG)
if fvgBullish
    box.new(bar_index[2], high[2], bar_index, low, color.new(color.aqua, 80), bgcolor=color.new(color.aqua, 90), text="FVG")
if fvgBearish
    box.new(bar_index[2], low[2], bar_index, high, color.new(color.orange, 80), bgcolor=color.new(color.orange, 90), text="FVG")

// Labels for BOS/CHOCH
if bosBullish
    label.new(bar_index[rightBars], high[rightBars], "BOS", color=color.green, textcolor=color.white, style=label.style_label_down, size=size.tiny)
if chochBullish
    label.new(bar_index[rightBars], high[rightBars], "CHOCH", color=color.teal, textcolor=color.white, style=label.style_label_down, size=size.tiny)
if bosBearish
    label.new(bar_index[rightBars], low[rightBars], "BOS", color=color.red, textcolor=color.white, style=label.style_label_up, size=size.tiny)
if chochBearish
    label.new(bar_index[rightBars], low[rightBars], "CHOCH", color=color.maroon, textcolor=color.white, style=label.style_label_up, size=size.tiny)

// Order Block Highlighting
if isOBBullish
    box.new(bar_index, high[1], bar_index + 5, low[1], color.new(color.green, 70), bgcolor=color.new(color.green, 80), text="OB")
if isOBBearish
    box.new(bar_index, high[1], bar_index + 5, low[1], color.new(color.red, 70), bgcolor=color.new(color.red, 80), text="OB")

// ==========================================
// ALERTS
// ==========================================

alertcondition(isCall, "CALL ALERT", "Premium CALL Signal Detected!")
alertcondition(isPut, "PUT ALERT", "Premium PUT Signal Detected!")
alertcondition((isCall or isPut) and (confidenceBull > 90 or confidenceBear > 90), "HIGH CONFIDENCE ALERT", "Extremely High Confidence Setup!")

// ==========================================
// PLOTS (Basic)
// ==========================================

plot(ema5, color=color.new(color.blue, 50), title="EMA 5")
plot(ema20, color=color.new(color.aqua, 50), title="EMA 20")
plot(ema50, color=color.new(color.orange, 50), title="EMA 50")
plot(ema200, color=color.new(color.red, 50), title="EMA 200")

plot(stValue, color=stBullish ? color.green : color.red, title="SuperTrend")
