//@version=6
strategy("SUPER DUPER MACHINE MASTER AI-STRATEGY", overlay=true, initial_capital=10000, default_qty_type=strategy.cash, default_qty_value=1000, commission_type=strategy.commission.percent, commission_value=0.03, slippage=1, max_bars_back=5000, process_orders_on_close=true)

// ============================================================================
// SECTION 1: INPUTS & CONFIGURATION
// ============================================================================

// --- Timeframe Settings ---
string group_tf = "1. Timeframe Engine Settings"
string htf_res = input.timeframe("60", "Higher Timeframe (HTF)", group=group_tf)

// --- Market Regime Settings ---
string group_regime = "2. Market Regime Engine"
int adx_len = input.int(14, "ADX Length", group=group_regime)
int adx_trend_thresh = input.int(22, "ADX Trend Threshold", group=group_regime)
int atr_len = input.int(14, "ATR Length", group=group_regime)
float atr_vol_mult = input.float(1.2, "ATR High Volatility Multiplier", group=group_regime)

// --- Market Structure Settings ---
string group_struct = "3. Market Structure Engine"
int swing_length = input.int(5, "Swing Pivot Strength (Left/Right)", group=group_struct)

// --- FVG & Order Block Settings ---
string group_smc = "4. SMC (FVG & Order Block) Settings"
int fvg_max_display = input.int(5, "Max Active FVGs to Track", group=group_smc)
int ob_max_display = input.int(5, "Max Active Order Blocks to Track", group=group_smc)
float ob_displacement_mult = input.float(1.3, "OB Displacement ATR Multiplier", group=group_smc)

// --- Momentum & Volume Settings ---
string group_mom = "5. Momentum & Volume Engine"
int rsi_len = input.int(14, "RSI Length", group=group_mom)
int macd_fast = input.int(12, "MACD Fast Length", group=group_mom)
int macd_slow = input.int(26, "MACD Slow Length", group=group_mom)
int macd_sig = input.int(9, "MACD Signal Length", group=group_mom)
int vol_ma_len = input.int(20, "Volume MA Length", group=group_mom)
float vol_expansion_ratio = input.float(1.25, "Volume Expansion Threshold", group=group_mom)

// --- Confidence Engine Weights & Thresholds ---
string group_conf = "6. Confidence Engine (0-100 Score)"
int w_htf = input.int(15, "Weight: HTF Direction", group=group_conf)
int w_struct = input.int(15, "Weight: Market Structure", group=group_conf)
int w_liq = input.int(15, "Weight: Liquidity Sweep", group=group_conf)
int w_sr = input.int(10, "Weight: S/R Confluence", group=group_conf)
int w_fvg = input.int(10, "Weight: FVG Alignment", group=group_conf)
int w_ob = input.int(10, "Weight: Order Block Alignment", group=group_conf)
int w_pd = input.int(5, "Weight: Premium/Discount", group=group_conf)
int w_mom = input.int(10, "Weight: Momentum Confirmation", group=group_conf)
int w_vol = input.int(5, "Weight: Volume Expansion", group=group_conf)
int w_rr = input.int(5, "Weight: Risk/Reward Ratio", group=group_conf)

int thresh_elite = input.int(90, "Elite Setup Threshold", group=group_conf)
int thresh_strong = input.int(85, "Strong Setup Threshold", group=group_conf)
int thresh_valid = input.int(75, "Valid Setup Threshold", group=group_conf)
int thresh_watch = input.int(65, "Watch Threshold", group=group_conf)

// --- Risk Management Engine ---
string group_risk = "7. Risk Management & Position Sizing"
float risk_per_trade = input.float(1.0, "Risk Per Trade (%)", minval=0.1, maxval=10.0, step=0.1, group=group_risk) / 100.0
float max_daily_loss = input.float(3.0, "Max Daily Loss (%)", minval=0.5, maxval=20.0, step=0.5, group=group_risk) / 100.0
int max_trades_per_day = input.int(5, "Max Trades Per Day", group=group_risk)
int max_consec_losses = input.int(3, "Max Consecutive Losses", group=group_risk)
int cooldown_bars = input.int(3, "Cooldown Bars Between Trades", group=group_risk)
float min_rr_ratio = input.float(1.5, "Minimum Risk/Reward Ratio", group=group_risk)
float atr_sl_mult = input.float(1.0, "SL ATR Buffer Multiplier", group=group_risk)

// --- Trade Target & Management Settings ---
string group_trade = "8. Target & Trade Management Engine"
float tp1_rr = input.float(1.5, "TP1 Target R:R", group=group_trade)
float tp2_rr = input.float(2.5, "TP2 Target R:R", group=group_trade)
float tp3_rr = input.float(4.0, "TP3 Target R:R", group=group_trade)
bool move_be_at_tp1 = input.bool(true, "Move Stop Loss to BE at TP1", group=group_trade)

// --- Visual & Dashboard Settings ---
string group_vis = "9. Visuals & Dashboard"
bool show_dashboard = input.bool(true, "Show Master Dashboard Table", group=group_vis)
bool show_structure = input.bool(true, "Show BOS / CHoCH Labels", group=group_vis)
bool show_fvg = input.bool(true, "Show Active FVGs", group=group_vis)
bool show_ob = input.bool(true, "Show Active Order Blocks", group=group_vis)

// ============================================================================
// SECTION 2: NON-REPAINTING MTF ENGINE
// ============================================================================

// Secure non-repainting security wrapper using [1] historical offset
f_security_close(_tf) =>
    request.security(syminfo.tickerid, _tf, close[1], barmerge.gaps_off, barmerge.lookahead_off)

f_security_ema(_tf, _len) =>
    request.security(syminfo.tickerid, _tf, ta.ema(close, _len)[1], barmerge.gaps_off, barmerge.lookahead_off)

f_security_high(_tf) =>
    request.security(syminfo.tickerid, _tf, high[1], barmerge.gaps_off, barmerge.lookahead_off)

f_security_low(_tf) =>
    request.security(syminfo.tickerid, _tf, low[1], barmerge.gaps_off, barmerge.lookahead_off)

// Fetch HTF EMAs
htf_close = f_security_close(htf_res)
htf_ema20 = f_security_ema(htf_res, 20)
htf_ema50 = f_security_ema(htf_res, 50)
htf_ema200 = f_security_ema(htf_res, 200)

// Determine HTF Trend Direction
bool htf_bullish = htf_close > htf_ema50 and htf_ema20 > htf_ema50 and htf_ema50 > htf_ema200
bool htf_bearish = htf_close < htf_ema50 and htf_ema20 < htf_ema50 and htf_ema50 < htf_ema200
string htf_trend_str = htf_bullish ? "BULLISH" : (htf_bearish ? "BEARISH" : "NEUTRAL")

// ============================================================================
// SECTION 3: MARKET REGIME ENGINE
// ============================================================================

// Base Calculations
ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)
ema200 = ta.ema(close, 200)

[di_plus, di_minus, adx_val] = ta.dmi(adx_len, adx_len)
atr_val = ta.atr(atr_len)
atr_ma = ta.sma(atr_val, 20)

// Volatility & Trend Metrics
bool is_high_vol = atr_val > atr_ma * atr_vol_mult
bool is_low_vol = atr_val < atr_ma * 0.8
bool is_ema_bull = close > ema50 and ema20 > ema50 and ema50 > ema200
bool is_ema_bear = close < ema50 and ema20 < ema50 and ema50 < ema200

// Regime Classification
string market_regime = "UNCLEAR"

if adx_val >= adx_trend_thresh and is_ema_bull
    market_regime := "TRENDING BULL"
else if adx_val >= adx_trend_thresh and is_ema_bear
    market_regime := "TRENDING BEAR"
else if adx_val < adx_trend_thresh and not is_high_vol and not is_low_vol
    market_regime := "RANGE"
else if is_high_vol
    market_regime := "HIGH VOLATILITY"
else if is_low_vol
    market_regime := "LOW VOLATILITY"
else if (is_ema_bull or is_ema_bear) and adx_val < adx_trend_thresh
    market_regime := "WEAK TREND"
else
    market_regime := "UNCLEAR"

// ============================================================================
// SECTION 4: MARKET STRUCTURE ENGINE
// ============================================================================

// Pivot Point Detection
ph = ta.pivothigh(high, swing_length, swing_length)
pl = ta.pivotlow(low, swing_length, swing_length)

var float last_ph = na
var float last_pl = na
var float prev_ph = na
var float prev_pl = na

if not na(ph)
    prev_ph := last_ph
    last_ph := ph

if not na(pl)
    prev_pl := last_pl
    last_pl := pl

// Market Structure Tracking (BOS & CHoCH)
var string struct_direction = "NEUTRAL"
bool is_bos_bull = false
bool is_bos_bear = false
bool is_choch_bull = false
bool is_choch_bear = false

// Break of Structure (BOS) and Change of Character (CHoCH)
if not na(last_ph) and ta.crossover(close, last_ph)
    if struct_direction == "BEARISH"
        is_choch_bull := true
    else if struct_direction == "BULLISH"
        is_bos_bull := true
    struct_direction := "BULLISH"

if not na(last_pl) and ta.crossunder(close, last_pl)
    if struct_direction == "BULLISH"
        is_choch_bear := true
    else if struct_direction == "BEARISH"
        is_bos_bear := true
    struct_direction := "BEARISH"

// Structure Labels
if show_structure
    if is_bos_bull
        label.new(bar_index, high, "BOS", color=color.green, textcolor=color.white, style=label.style_label_down, size=size.tiny)
    if is_choch_bull
        label.new(bar_index, high, "CHoCH", color=color.lime, textcolor=color.black, style=label.style_label_down, size=size.tiny)
    if is_bos_bear
        label.new(bar_index, low, "BOS", color=color.red, textcolor=color.white, style=label.style_label_up, size=size.tiny)
    if is_choch_bear
        label.new(bar_index, low, "CHoCH", color=color.maroon, textcolor=color.white, style=label.style_label_up, size=size.tiny)

// ============================================================================
// SECTION 5: LIQUIDITY ENGINE
// ============================================================================

// Session / Daily High & Low
float pdh = f_security_high("D")
float pdl = f_security_low("D")

// Liquidity Sweep Logic
bool ssl_swept = not na(last_pl) and low < last_pl and close > last_pl
bool bsl_swept = not na(last_ph) and high > last_ph and close < last_ph

if ssl_swept and show_structure
    label.new(bar_index, low, "SSL SWEEP", color=color.teal, textcolor=color.white, style=label.style_label_up, size=size.tiny)
if bsl_swept and show_structure
    label.new(bar_index, high, "BSL SWEEP", color=color.purple, textcolor=color.white, style=label.style_label_down, size=size.tiny)

// ============================================================================
// SECTION 6: SMART S/R ENGINE
// ============================================================================

// Active Dealing Range S/R Levels
var float range_high = na
var float range_low = na

if not na(ph)
    range_high := ph
if not na(pl)
    range_low := pl

if na(range_high)
    range_high := ta.highest(high, 50)
if na(range_low)
    range_low := ta.lowest(low, 50)

float active_range = range_high - range_low
float eq_level = range_low + (active_range * 0.50)
float s1_level = range_low + (active_range * 0.25)
float r1_level = range_low + (active_range * 0.75)

bool near_support = close <= s1_level or (not na(last_pl) and math.abs(close - last_pl) <= atr_val)
bool near_resistance = close >= r1_level or (not na(last_ph) and math.abs(close - last_ph) <= atr_val)

// ============================================================================
// SECTION 7: FVG ENGINE (WITH DYNAMIC MITIGATION CLEANUP & VISUALS)
// ============================================================================

bool is_bull_fvg = low[0] > high[2] and close[1] > high[2]
bool is_bear_fvg = high[0] < low[2] and close[1] < low[2]

var float[] bull_fvg_top = array.new_float(0)
var float[] bull_fvg_bottom = array.new_float(0)
var box[] bull_fvg_boxes = array.new_box(0)

var float[] bear_fvg_top = array.new_float(0)
var float[] bear_fvg_bottom = array.new_float(0)
var box[] bear_fvg_boxes = array.new_box(0)

// Register new Bullish FVG
if is_bull_fvg
    array.push(bull_fvg_top, low[0])
    array.push(bull_fvg_bottom, high[2])
    box b = show_fvg ? box.new(bar_index - 2, low[0], bar_index + 10, high[2], bgcolor=color.new(color.green, 85), border_color=color.green) : na
    array.push(bull_fvg_boxes, b)

// Register new Bearish FVG
if is_bear_fvg
    array.push(bear_fvg_top, low[2])
    array.push(bear_fvg_bottom, high[0])
    box b = show_fvg ? box.new(bar_index - 2, low[2], bar_index + 10, high[0], bgcolor=color.new(color.red, 85), border_color=color.red) : na
    array.push(bear_fvg_boxes, b)

// Clean Mitigated Bullish FVGs (Price closes below bottom of FVG)
if array.size(bull_fvg_top) > 0
    for i = array.size(bull_fvg_top) - 1 to 0 by -1
        if close < array.get(bull_fvg_bottom, i)
            array.remove(bull_fvg_top, i)
            array.remove(bull_fvg_bottom, i)
            box b = array.remove(bull_fvg_boxes, i)
            if not na(b)
                box.delete(b)

// Clean Mitigated Bearish FVGs (Price closes above top of FVG)
if array.size(bear_fvg_top) > 0
    for i = array.size(bear_fvg_top) - 1 to 0 by -1
        if close > array.get(bear_fvg_top, i)
            array.remove(bear_fvg_top, i)
            array.remove(bear_fvg_bottom, i)
            box b = array.remove(bear_fvg_boxes, i)
            if not na(b)
                box.delete(b)

// Trim excess FVGs exceeding max limit
while array.size(bull_fvg_top) > fvg_max_display
    array.remove(bull_fvg_top, 0)
    array.remove(bull_fvg_bottom, 0)
    box b = array.remove(bull_fvg_boxes, 0)
    if not na(b)
        box.delete(b)

while array.size(bear_fvg_top) > fvg_max_display
    array.remove(bear_fvg_top, 0)
    array.remove(bear_fvg_bottom, 0)
    box b = array.remove(bear_fvg_boxes, 0)
    if not na(b)
        box.delete(b)

// Check if price is currently inside an active FVG
bool inside_bull_fvg = false
bool inside_bear_fvg = false

if array.size(bull_fvg_top) > 0
    for i = 0 to array.size(bull_fvg_top) - 1
        if low <= array.get(bull_fvg_top, i) and high >= array.get(bull_fvg_bottom, i)
            inside_bull_fvg := true

if array.size(bear_fvg_top) > 0
    for i = 0 to array.size(bear_fvg_top) - 1
        if high >= array.get(bear_fvg_bottom, i) and low <= array.get(bear_fvg_top, i)
            inside_bear_fvg := true

// ============================================================================
// SECTION 8: ORDER BLOCK ENGINE (WITH DYNAMIC MITIGATION CLEANUP & VISUALS)
// ============================================================================

float candle_body = math.abs(close - open)
bool strong_displacement = candle_body >= (atr_val * ob_displacement_mult)

bool is_bull_ob = close[1] < open[1] and close[0] > open[0] and strong_displacement and (is_bos_bull[0] or is_choch_bull[0])
bool is_bear_ob = close[1] > open[1] and close[0] < open[0] and strong_displacement and (is_bos_bear[0] or is_choch_bear[0])

var float[] bull_ob_top = array.new_float(0)
var float[] bull_ob_bottom = array.new_float(0)
var box[] bull_ob_boxes = array.new_box(0)

var float[] bear_ob_top = array.new_float(0)
var float[] bear_ob_bottom = array.new_float(0)
var box[] bear_ob_boxes = array.new_box(0)

// Register new Bullish OB
if is_bull_ob
    array.push(bull_ob_top, high[1])
    array.push(bull_ob_bottom, low[1])
    box b = show_ob ? box.new(bar_index - 1, high[1], bar_index + 10, low[1], bgcolor=color.new(color.teal, 80), border_color=color.teal) : na
    array.push(bull_ob_boxes, b)

// Register new Bearish OB
if is_bear_ob
    array.push(bear_ob_top, high[1])
    array.push(bear_ob_bottom, low[1])
    box b = show_ob ? box.new(bar_index - 1, high[1], bar_index + 10, low[1], bgcolor=color.new(color.purple, 80), border_color=color.purple) : na
    array.push(bear_ob_boxes, b)

// Clean Mitigated Bullish Order Blocks (Price closes below bottom of OB)
if array.size(bull_ob_top) > 0
    for i = array.size(bull_ob_top) - 1 to 0 by -1
        if close < array.get(bull_ob_bottom, i)
            array.remove(bull_ob_top, i)
            array.remove(bull_ob_bottom, i)
            box b = array.remove(bull_ob_boxes, i)
            if not na(b)
                box.delete(b)

// Clean Mitigated Bearish Order Blocks (Price closes above top of OB)
if array.size(bear_ob_top) > 0
    for i = array.size(bear_ob_top) - 1 to 0 by -1
        if close > array.get(bear_ob_top, i)
            array.remove(bear_ob_top, i)
            array.remove(bear_ob_bottom, i)
            box b = array.remove(bear_ob_boxes, i)
            if not na(b)
                box.delete(b)

// Trim excess OBs exceeding max limit
while array.size(bull_ob_top) > ob_max_display
    array.remove(bull_ob_top, 0)
    array.remove(bull_ob_bottom, 0)
    box b = array.remove(bull_ob_boxes, 0)
    if not na(b)
        box.delete(b)

while array.size(bear_ob_top) > ob_max_display
    array.remove(bear_ob_top, 0)
    array.remove(bear_ob_bottom, 0)
    box b = array.remove(bear_ob_boxes, 0)
    if not na(b)
        box.delete(b)

// Check if price is inside an active Order Block
bool inside_bull_ob = false
bool inside_bear_ob = false

if array.size(bull_ob_top) > 0
    for i = 0 to array.size(bull_ob_top) - 1
        if low <= array.get(bull_ob_top, i) and high >= array.get(bull_ob_bottom, i)
            inside_bull_ob := true

if array.size(bear_ob_top) > 0
    for i = 0 to array.size(bear_ob_top) - 1
        if high >= array.get(bear_ob_bottom, i) and low <= array.get(bear_ob_top, i)
            inside_bear_ob := true

// ============================================================================
// SECTION 9: PREMIUM / DISCOUNT ENGINE
// ============================================================================

bool in_discount = close < eq_level
bool in_premium = close > eq_level
string pd_zone_str = in_discount ? "DISCOUNT" : (in_premium ? "PREMIUM" : "EQUILIBRIUM")

// ============================================================================
// SECTION 10: MOMENTUM ENGINE
// ============================================================================

rsi_val = ta.rsi(close, rsi_len)
[macd_line, macd_sig_line, macd_hist] = ta.macd(close, macd_fast, macd_slow, macd_sig)

bool mom_bullish = rsi_val >= 50 and macd_hist > 0 and di_plus > di_minus
bool mom_bearish = rsi_val <= 50 and macd_hist < 0 and di_minus > di_plus
string mom_str = mom_bullish ? "STRONG BULL" : (mom_bearish ? "STRONG BEAR" : "NEUTRAL")

// ============================================================================
// SECTION 11: VOLUME ENGINE
// ============================================================================

vol_ma = ta.sma(volume, vol_ma_len)
bool vol_expansion = volume >= vol_ma * vol_expansion_ratio
bool vol_spike = volume >= vol_ma * 2.0
bool vol_weak = volume < vol_ma * 0.75
string vol_str = vol_spike ? "SPIKE" : (vol_expansion ? "EXPANSION" : (vol_weak ? "WEAK" : "NORMAL"))

// ============================================================================
// SECTION 12: AI-LIKE CONFIDENCE ENGINE (0-100 WEIGHTED SCORE)
// ============================================================================

// Bullish Confidence Engine Score
int conf_bull = 0

if htf_bullish
    conf_bull += w_htf
if struct_direction == "BULLISH" or is_bos_bull or is_choch_bull
    conf_bull += w_struct
if ssl_swept
    conf_bull += w_liq
if near_support
    conf_bull += w_sr
if inside_bull_fvg or is_bull_fvg
    conf_bull += w_fvg
if inside_bull_ob or is_bull_ob
    conf_bull += w_ob
if in_discount
    conf_bull += w_pd
if mom_bullish
    conf_bull += w_mom
if vol_expansion or vol_spike
    conf_bull += w_vol
if min_rr_ratio >= 1.5
    conf_bull += w_rr

// Bearish Confidence Engine Score
int conf_bear = 0

if htf_bearish
    conf_bear += w_htf
if struct_direction == "BEARISH" or is_bos_bear or is_choch_bear
    conf_bear += w_struct
if bsl_swept
    conf_bear += w_liq
if near_resistance
    conf_bear += w_sr
if inside_bear_fvg or is_bear_fvg
    conf_bear += w_fvg
if inside_bear_ob or is_bear_ob
    conf_bear += w_ob
if in_premium
    conf_bear += w_pd
if mom_bearish
    conf_bear += w_mom
if vol_expansion or vol_spike
    conf_bear += w_vol
if min_rr_ratio >= 1.5
    conf_bear += w_rr

// Plot Confidence Scores for Alert placeholders
plot_conf_bull = plot(conf_bull, title="Bullish Confidence Score", display=display.none)
plot_conf_bear = plot(conf_bear, title="Bearish Confidence Score", display=display.none)

// ============================================================================
// SECTION 13: ADAPTIVE MARKET MODE & ENTRY QUALITY GATE
// ============================================================================

string signal_type_bull = "NONE"
if conf_bull >= thresh_elite
    signal_type_bull := "ELITE BUY"
else if conf_bull >= thresh_strong
    signal_type_bull := "STRONG BUY"
else if conf_bull >= thresh_valid
    signal_type_bull := "BUY"
else if conf_bull >= thresh_watch
    signal_type_bull := "WATCH"

string signal_type_bear = "NONE"
if conf_bear >= thresh_elite
    signal_type_bear := "ELITE SELL"
else if conf_bear >= thresh_strong
    signal_type_bear := "STRONG SELL"
else if conf_bear >= thresh_valid
    signal_type_bear := "SELL"
else if conf_bear >= thresh_watch
    signal_type_bear := "WATCH"

// Adaptive Entry Setup Conditions
bool trend_continuation_buy = htf_bullish and in_discount and (inside_bull_fvg or inside_bull_ob or is_bos_bull) and conf_bull >= thresh_valid
bool reversal_buy = ssl_swept and is_choch_bull and conf_bull >= thresh_strong

bool trend_continuation_sell = htf_bearish and in_premium and (inside_bear_fvg or inside_bear_ob or is_bos_bear) and conf_bear >= thresh_valid
bool reversal_sell = bsl_swept and is_choch_bear and conf_bear >= thresh_strong

bool valid_buy_setup = (trend_continuation_buy or reversal_buy) and market_regime != "UNCLEAR"
bool valid_sell_setup = (trend_continuation_sell or reversal_sell) and market_regime != "UNCLEAR"

// False Breakout Filter
bool false_breakout_bull = high > range_high and close < range_high
bool false_breakout_bear = low < range_low and close > range_low

if false_breakout_bull or false_breakout_bear
    valid_buy_setup := false
    valid_sell_setup := false

// ============================================================================
// SECTION 14: RISK ENGINE & DAILY RISK FILTERS
// ============================================================================

var int trades_today = 0
var float daily_start_equity = strategy.equity
var int last_trade_day = -1
var int consecutive_losses = 0

current_day = dayofmonth

if current_day != last_trade_day
    trades_today := 0
    daily_start_equity := strategy.equity
    last_trade_day := current_day

float daily_pnl_pct = (strategy.equity - daily_start_equity) / daily_start_equity
bool daily_risk_exceeded = (daily_pnl_pct <= -max_daily_loss) or (trades_today >= max_trades_per_day) or (consecutive_losses >= max_consec_losses)

// Cooldown Engine
var int last_exit_bar = 0
bool cooldown_active = (bar_index - last_exit_bar) < cooldown_bars

// Entry Quality Gate Verification
bool gate_pass_buy = valid_buy_setup and not daily_risk_exceeded and not cooldown_active and strategy.position_size == 0
bool gate_pass_sell = valid_sell_setup and not daily_risk_exceeded and not cooldown_active and strategy.position_size == 0

// ============================================================================
// SECTION 15: SMART SL / TP & POSITION SIZING ENGINE
// ============================================================================

// Pre-Calculated Potential Entry Stop Losses & Targets
float long_sl_calc = (not na(last_pl) ? last_pl : low - (atr_val * 1.5)) - (atr_val * atr_sl_mult)
float short_sl_calc = (not na(last_ph) ? last_ph : high + (atr_val * 1.5)) + (atr_val * atr_sl_mult)

float long_risk_dist_calc = math.max(close - long_sl_calc, syminfo.mintick)
float short_risk_dist_calc = math.max(short_sl_calc - close, syminfo.mintick)

float account_risk_cash = strategy.equity * risk_per_trade
float pos_qty_long = account_risk_cash / long_risk_dist_calc
float pos_qty_short = account_risk_cash / short_risk_dist_calc

bool long_rr_valid = ((close + (long_risk_dist_calc * tp1_rr)) - close) / long_risk_dist_calc >= min_rr_ratio
bool short_rr_valid = (close - (close - (short_risk_dist_calc * tp1_rr))) / short_risk_dist_calc >= min_rr_ratio

// Persistent Trade Execution Target Variables (Locked at Entry fill)
var float active_entry_price = na
var float active_sl_price = na
var float active_tp1_price = na
var float active_tp2_price = na
var float active_tp3_price = na
var bool tp1_hit = false

// ============================================================================
// SECTION 16: TRADE EXECUTION & MACHINE TRADE MANAGEMENT
// ============================================================================

if gate_pass_buy and long_rr_valid
    strategy.entry("Machine Long", strategy.long, qty=pos_qty_long)
    trades_today += 1
    active_entry_price := close
    active_sl_price := long_sl_calc
    active_tp1_price := close + (long_risk_dist_calc * tp1_rr)
    active_tp2_price := close + (long_risk_dist_calc * tp2_rr)
    active_tp3_price := close + (long_risk_dist_calc * tp3_rr)
    tp1_hit := false
    label.new(bar_index, low, signal_type_bull + "\nScore: " + str.tostring(conf_bull), color=color.green, textcolor=color.white, style=label.style_label_up)

if gate_pass_sell and short_rr_valid
    strategy.entry("Machine Short", strategy.short, qty=pos_qty_short)
    trades_today += 1
    active_entry_price := close
    active_sl_price := short_sl_calc
    active_tp1_price := close - (short_risk_dist_calc * tp1_rr)
    active_tp2_price := close - (short_risk_dist_calc * tp2_rr)
    active_tp3_price := close - (short_risk_dist_calc * tp3_rr)
    tp1_hit := false
    label.new(bar_index, high, signal_type_bear + "\nScore: " + str.tostring(conf_bear), color=color.red, textcolor=color.white, style=label.style_label_down)

// Active Position Management
if strategy.position_size > 0
    // Check if TP1 target has been reached
    if high >= active_tp1_price
        tp1_hit := true
        if move_be_at_tp1
            active_sl_price := math.max(active_sl_price, active_entry_price)

    if not tp1_hit
        strategy.exit("Long Exit TP1/SL", "Machine Long", qty_percent=50, limit=active_tp1_price, stop=active_sl_price)
        strategy.exit("Long Exit TP3", "Machine Long", limit=active_tp3_price, stop=active_sl_price)
    else
        strategy.exit("Long Exit Running", "Machine Long", limit=active_tp3_price, stop=active_sl_price)

    // Early Exit on Opposite Structural Shift
    if is_choch_bear
        strategy.close("Machine Long", comment="Opposite CHoCH Exit")
        last_exit_bar := bar_index

if strategy.position_size < 0
    // Check if TP1 target has been reached
    if low <= active_tp1_price
        tp1_hit := true
        if move_be_at_tp1
            active_sl_price := math.min(active_sl_price, active_entry_price)

    if not tp1_hit
        strategy.exit("Short Exit TP1/SL", "Machine Short", qty_percent=50, limit=active_tp1_price, stop=active_sl_price)
        strategy.exit("Short Exit TP3", "Machine Short", limit=active_tp3_price, stop=active_sl_price)
    else
        strategy.exit("Short Exit Running", "Machine Short", limit=active_tp3_price, stop=active_sl_price)

    // Early Exit on Opposite Structural Shift
    if is_choch_bull
        strategy.close("Machine Short", comment="Opposite CHoCH Exit")
        last_exit_bar := bar_index

// Track Losses
if strategy.closedtrades > 0
    if ta.change(strategy.closedtrades) > 0
        if strategy.closedtrades.profit(strategy.closedtrades - 1) < 0
            consecutive_losses += 1
        else
            consecutive_losses := 0
        last_exit_bar := bar_index

// Reset Position Target Variables when Flat
if strategy.position_size == 0
    active_entry_price := na
    active_sl_price := na
    active_tp1_price := na
    active_tp2_price := na
    active_tp3_price := na
    tp1_hit := false

// ============================================================================
// SECTION 17: MASTER DASHBOARD TABLE
// ============================================================================

var table dashboard = table.new(position.top_right, 2, 13, bgcolor=color.new(color.black, 15), border_color=color.gray, border_width=1)

if show_dashboard and barstate.islast
    // Header
    table.cell(dashboard, 0, 0, "ENGINE MODULE", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(dashboard, 1, 0, "STATUS / VALUE", bgcolor=color.navy, text_color=color.white, text_size=size.small)

    // Row 1: Regime
    table.cell(dashboard, 0, 1, "REGIME", text_color=color.white, text_size=size.small)
    table.cell(dashboard, 1, 1, market_regime, bgcolor=market_regime == "UNCLEAR" ? color.maroon : color.teal, text_color=color.white, text_size=size.small)

    // Row 2: HTF Trend
    table.cell(dashboard, 0, 2, "HTF TREND", text_color=color.white, text_size=size.small)
    table.cell(dashboard, 1, 2, htf_trend_str, bgcolor=htf_bullish ? color.green : (htf_bearish ? color.red : color.gray), text_color=color.white, text_size=size.small)

    // Row 3: Structure
    table.cell(dashboard, 0, 3, "STRUCTURE", text_color=color.white, text_size=size.small)
    table.cell(dashboard, 1, 3, struct_direction, text_color=struct_direction == "BULLISH" ? color.green : color.red, text_size=size.small)

    // Row 4: Liquidity
    table.cell(dashboard, 0, 4, "LIQUIDITY", text_color=color.white, text_size=size.small)
    table.cell(dashboard, 1, 4, ssl_swept ? "SSL SWEPT" : (bsl_swept ? "BSL SWEPT" : "NEUTRAL"), text_color=color.yellow, text_size=size.small)

    // Row 5: SMC Confluence
    table.cell(dashboard, 0, 5, "SMC CONFLUENCE", text_color=color.white, text_size=size.small)
    string smc_str = (inside_bull_fvg or inside_bear_fvg) ? "FVG ACTIVE" : ((inside_bull_ob or inside_bear_ob) ? "OB ACTIVE" : "NONE")
    table.cell(dashboard, 1, 5, smc_str, text_color=color.aqua, text_size=size.small)

    // Row 6: Premium/Discount
    table.cell(dashboard, 0, 6, "DEALING ZONE", text_color=color.white, text_size=size.small)
    table.cell(dashboard, 1, 6, pd_zone_str, text_color=in_discount ? color.lime : color.orange, text_size=size.small)

    // Row 7: Momentum
    table.cell(dashboard, 0, 7, "MOMENTUM", text_color=color.white, text_size=size.small)
    table.cell(dashboard, 1, 7, mom_str, text_color=mom_bullish ? color.green : color.red, text_size=size.small)

    // Row 8: Volume
    table.cell(dashboard, 0, 8, "VOLUME", text_color=color.white, text_size=size.small)
    table.cell(dashboard, 1, 8, vol_str, text_color=vol_expansion ? color.lime : color.white, text_size=size.small)

    // Row 9: Confidence
    table.cell(dashboard, 0, 9, "AI CONFIDENCE", text_color=color.white, text_size=size.small)
    int top_conf = math.max(conf_bull, conf_bear)
    table.cell(dashboard, 1, 9, str.tostring(top_conf) + "/100", bgcolor=top_conf >= thresh_strong ? color.green : (top_conf >= thresh_valid ? color.olive : color.gray), text_color=color.white, text_size=size.small)

    // Row 10: Master Signal
    table.cell(dashboard, 0, 10, "PRIMARY SIGNAL", text_color=color.white, text_size=size.small)
    string active_signal = conf_bull >= thresh_valid ? signal_type_bull : (conf_bear >= thresh_valid ? signal_type_bear : "NO TRADE")
    table.cell(dashboard, 1, 10, active_signal, bgcolor=conf_bull >= thresh_valid ? color.green : (conf_bear >= thresh_valid ? color.red : color.gray), text_color=color.white, text_size=size.small)

    // Row 11: Trade Status
    table.cell(dashboard, 0, 11, "TRADE STATUS", text_color=color.white, text_size=size.small)
    string pos_str = strategy.position_size > 0 ? "LONG ACTIVE" : (strategy.position_size < 0 ? "SHORT ACTIVE" : "FLAT")
    table.cell(dashboard, 1, 11, pos_str, text_color=color.white, text_size=size.small)

    // Row 12: Daily Risk
    table.cell(dashboard, 0, 12, "DAILY RISK", text_color=color.white, text_size=size.small)
    table.cell(dashboard, 1, 12, daily_risk_exceeded ? "LIMIT REACHED" : "SAFE", bgcolor=daily_risk_exceeded ? color.red : color.green, text_color=color.white, text_size=size.small)

// ============================================================================
// SECTION 18: ALERT ENGINE
// ============================================================================

alertcondition(gate_pass_buy and long_rr_valid, title="BUY Signal Alert", message="SUPER DUPER MACHINE MASTER: BUY Signal Generated! Bullish Confidence Score: {{plot(\"Bullish Confidence Score\")}}")
alertcondition(gate_pass_sell and short_rr_valid, title="SELL Signal Alert", message="SUPER DUPER MACHINE MASTER: SELL Signal Generated! Bearish Confidence Score: {{plot(\"Bearish Confidence Score\")}}")
alertcondition(is_bos_bull or is_bos_bear, title="BOS Alert", message="SUPER DUPER MACHINE MASTER: Break of Structure (BOS) Detected.")
alertcondition(is_choch_bull or is_choch_bear, title="CHoCH Alert", message="SUPER DUPER MACHINE MASTER: Change of Character (CHoCH) Detected.")
alertcondition(ssl_swept or bsl_swept, title="Liquidity Sweep Alert", message="SUPER DUPER MACHINE MASTER: Liquidity Sweep Detected.")
alertcondition(daily_risk_exceeded, title="Daily Risk Exceeded Alert", message="SUPER DUPER MACHINE MASTER: Daily Risk Limit Reached. Trading Paused.")
