//@version=6
indicator("Market Structure Indicator - BOS, CHoCH, MT & CE", shorttitle="Market Structure [ICT]", overlay=true, max_lines_count=500, max_boxes_count=500, max_labels_count=500)

// ============================================================================
// INPUT CONFIGURATION
// ============================================================================

// Group 1: Market Structure Inputs (BOS & CHoCH)
string G_STRUCT      = "1. Market Structure (BOS & CHoCH)"
int pivotLeft        = input.int(5, "Pivot Left Length", minval=1, group=G_STRUCT, tooltip="Number of left bars for pivot high/low detection")
int pivotRight       = input.int(5, "Pivot Right Length", minval=1, group=G_STRUCT, tooltip="Number of right bars for pivot high/low detection")
string breakMode     = input.string("Close", "Structure Break Mode", options=["Close", "Wick"], group=G_STRUCT, tooltip="Choose whether Close price or High/Low Wick breaks structure")
bool showBOS         = input.bool(true, "Show Break of Structure (BOS)", group=G_STRUCT)
bool showCHoCH       = input.bool(true, "Show Change of Character (CHoCH)", group=G_STRUCT)
bool showPivotPoints = input.bool(false, "Show Swing Pivot Labels", group=G_STRUCT)

// Group 2: Order Blocks & Mean Threshold (MT)
string G_OB          = "2. Order Blocks & Mean Threshold (MT)"
bool showOB          = input.bool(true, "Show Order Blocks", group=G_OB)
bool showMT          = input.bool(true, "Show Mean Threshold (MT - 50% OB Level)", group=G_OB, tooltip="Mean Threshold is the 50% midpoint of an Order Block zone")
int maxOBs           = input.int(10, "Max Active Order Blocks", minval=1, maxval=50, group=G_OB)
string obSource      = input.string("Body", "OB Candle Range", options=["Body", "Full Range"], group=G_OB)

// Group 3: Fair Value Gaps & Consequent Encroachment (CE)
string G_FVG         = "3. Fair Value Gaps & Consequent Encroachment (CE)"
bool showFVG         = input.bool(true, "Show Fair Value Gaps (FVG)", group=G_FVG)
bool showCE          = input.bool(true, "Show Consequent Encroachment (CE - 50% FVG Level)", group=G_FVG, tooltip="Consequent Encroachment is the exact 50% midpoint of an FVG gap")
int maxFVGs          = input.int(10, "Max Active FVGs", minval=1, maxval=50, group=G_FVG)
bool filterMitigated = input.bool(true, "Hide Fully Mitigated FVGs", group=G_FVG)

// Group 4: Visual Styling & Colors
string G_STYLE       = "4. Visual Styling & Colors"
color colBullBOS     = input.color(color.new(color.green, 20), "Bullish BOS / CHoCH", group=G_STYLE)
color colBearBOS     = input.color(color.new(color.red, 20), "Bearish BOS / CHoCH", group=G_STYLE)
color colBullOB      = input.color(color.new(#089981, 80), "Bullish Order Block", group=G_STYLE)
color colBearOB      = input.color(color.new(#f23645, 80), "Bearish Order Block", group=G_STYLE)
color colBullMT      = input.color(color.new(#00e676, 0), "Bullish Mean Threshold (MT)", group=G_STYLE)
color colBearMT      = input.color(color.new(#ff5252, 0), "Bearish Mean Threshold (MT)", group=G_STYLE)
color colBullFVG     = input.color(color.new(#2962ff, 85), "Bullish FVG", group=G_STYLE)
color colBearFVG     = input.color(color.new(#ff6d00, 85), "Bearish FVG", group=G_STYLE)
color colCE          = input.color(color.new(#ffd700, 0), "Consequent Encroachment (CE)", group=G_STYLE)

// Group 5: Dashboard
string G_DASH        = "5. Statistics Dashboard"
bool showDashboard   = input.bool(true, "Show Info Dashboard", group=G_DASH)
string dashPosition  = input.string("Top Right", "Dashboard Position", options=["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group=G_DASH)

// ============================================================================
// CUSTOM USER DEFINED TYPES (UDTs)
// ============================================================================

type OrderBlock
    box  obBox
    line mtLine

type FairValueGap
    box  fvgBox
    line ceLine
    float topVal
    float botVal

// ============================================================================
// GLOBAL DATA STRUCTURES & ARRAYS
// ============================================================================

var OrderBlock[]   bullOBs  = array.new<OrderBlock>()
var OrderBlock[]   bearOBs  = array.new<OrderBlock>()
var FairValueGap[] bullFVGs = array.new<FairValueGap>()
var FairValueGap[] bearFVGs = array.new<FairValueGap>()

// State variables for market structure tracking
var float activeHigh    = na
var int   activeHighIdx = na
var float activeLow     = na
var int   activeLowIdx  = na

var int   marketTrend   = 0 // +1 = Bullish, -1 = Bearish

// Counters for dashboard statistics
var int countBullBOS   = 0
var int countBearBOS   = 0
var int countBullCHoCH = 0
var int countBearCHoCH = 0

// ============================================================================
// STEP 1: SWING HIGH / SWING LOW PIVOT DETECTION & UPDATE
// ============================================================================

float ph = ta.pivothigh(high, pivotLeft, pivotRight)
float pl = ta.pivotlow(low, pivotLeft, pivotRight)

int ph_bar_idx = bar_index - pivotRight
int pl_bar_idx = bar_index - pivotRight

if not na(ph)
    activeHigh    := ph
    activeHighIdx := ph_bar_idx
    if showPivotPoints
        label.new(ph_bar_idx, ph, "SH", style=label.style_label_down, color=color.new(color.red, 40), textcolor=color.white, size=size.tiny)

if not na(pl)
    activeLow     := pl
    activeLowIdx  := pl_bar_idx
    if showPivotPoints
        label.new(pl_bar_idx, pl, "SL", style=label.style_label_up, color=color.new(color.green, 40), textcolor=color.white, size=size.tiny)

// ============================================================================
// STEP 2: BREAK OF STRUCTURE (BOS) & CHANGE OF CHARACTER (CHOCH)
// ============================================================================

float triggerHigh = breakMode == "Close" ? close : high
float triggerLow  = breakMode == "Close" ? close : low

bool isBullBreak = not na(activeHigh) and triggerHigh > activeHigh and triggerHigh[1] <= activeHigh
bool isBearBreak = not na(activeLow) and triggerLow < activeLow and triggerLow[1] >= activeLow

// Trigger flags for alerts
bool alertBullBOS   = false
bool alertBearBOS   = false
bool alertBullCHoCH = false
bool alertBearCHoCH = false

if isBullBreak
    if marketTrend == -1 or marketTrend == 0
        // Structure Reversal: CHoCH
        marketTrend := 1
        countBullCHoCH += 1
        alertBullCHoCH := true
        if showCHoCH
            line.new(activeHighIdx, activeHigh, bar_index, activeHigh, color=colBullBOS, width=2, style=line.style_dashed)
            label.new(math.round((activeHighIdx + bar_index) / 2), activeHigh, "Bullish CHoCH", color=colBullBOS, textcolor=color.white, style=label.style_label_down, size=size.small)
    else
        // Structure Continuation: BOS
        countBullBOS += 1
        alertBullBOS := true
        if showBOS
            line.new(activeHighIdx, activeHigh, bar_index, activeHigh, color=colBullBOS, width=1, style=line.style_solid)
            label.new(math.round((activeHighIdx + bar_index) / 2), activeHigh, "Bullish BOS", color=color.new(colBullBOS, 30), textcolor=color.white, style=label.style_label_down, size=size.small)

    // Reset active High to prevent re-triggering on same level until new pivot high forms
    activeHigh := na

if isBearBreak
    if marketTrend == 1 or marketTrend == 0
        // Structure Reversal: CHoCH
        marketTrend := -1
        countBearCHoCH += 1
        alertBearCHoCH := true
        if showCHoCH
            line.new(activeLowIdx, activeLow, bar_index, activeLow, color=colBearBOS, width=2, style=line.style_dashed)
            label.new(math.round((activeLowIdx + bar_index) / 2), activeLow, "Bearish CHoCH", color=colBearBOS, textcolor=color.white, style=label.style_label_up, size=size.small)
    else
        // Structure Continuation: BOS
        countBearBOS += 1
        alertBearBOS := true
        if showBOS
            line.new(activeLowIdx, activeLow, bar_index, activeLow, color=colBearBOS, width=1, style=line.style_solid)
            label.new(math.round((activeLowIdx + bar_index) / 2), activeLow, "Bearish BOS", color=color.new(colBearBOS, 30), textcolor=color.white, style=label.style_label_up, size=size.small)

    // Reset active Low to prevent re-triggering on same level until new pivot low forms
    activeLow := na

// ============================================================================
// STEP 3: ORDER BLOCKS (OB) & MEAN THRESHOLD (MT)
// ============================================================================

// Detect Bullish Order Block on Bullish Break (lowest down-close candle before expansion)
if isBullBreak and showOB
    int obIdx = bar_index
    float obTop = low[1]
    float obBot = low[1]

    int scanLimit = math.min(50, bar_index - (na(activeHighIdx) ? bar_index - 50 : activeHighIdx) + 5)
    float lowestVal = 1e10

    for i = 1 to scanLimit
        float checkPrice = obSource == "Body" ? math.min(open[i], close[i]) : low[i]
        if checkPrice < lowestVal
            lowestVal := checkPrice
            obIdx := bar_index - i
            obTop := obSource == "Body" ? math.max(open[i], close[i]) : high[i]
            obBot := obSource == "Body" ? math.min(open[i], close[i]) : low[i]

    float mtLevel = (obTop + obBot) / 2.0

    box obBox = box.new(obIdx, obTop, bar_index + 10, obBot, bgcolor=colBullOB, border_color=color.new(colBullOB, 0), border_style=line.style_solid)
    line mtLine = showMT ? line.new(obIdx, mtLevel, bar_index + 10, mtLevel, color=colBullMT, width=2, style=line.style_dashed) : na

    OrderBlock newOB = OrderBlock.new(obBox, mtLine)
    array.push(bullOBs, newOB)

    if array.size(bullOBs) > maxOBs
        OrderBlock oldOB = array.remove(bullOBs, 0)
        box.delete(oldOB.obBox)
        if not na(oldOB.mtLine)
            line.delete(oldOB.mtLine)

// Detect Bearish Order Block on Bearish Break (highest up-close candle before expansion)
if isBearBreak and showOB
    int obIdx = bar_index
    float obTop = high[1]
    float obBot = high[1]

    int scanLimit = math.min(50, bar_index - (na(activeLowIdx) ? bar_index - 50 : activeLowIdx) + 5)
    float highestVal = -1e10

    for i = 1 to scanLimit
        float checkPrice = obSource == "Body" ? math.max(open[i], close[i]) : high[i]
        if checkPrice > highestVal
            highestVal := checkPrice
            obIdx := bar_index - i
            obTop := obSource == "Body" ? math.max(open[i], close[i]) : high[i]
            obBot := obSource == "Body" ? math.min(open[i], close[i]) : low[i]

    float mtLevel = (obTop + obBot) / 2.0

    box obBox = box.new(obIdx, obTop, bar_index + 10, obBot, bgcolor=colBearOB, border_color=color.new(colBearOB, 0), border_style=line.style_solid)
    line mtLine = showMT ? line.new(obIdx, mtLevel, bar_index + 10, mtLevel, color=colBearMT, width=2, style=line.style_dashed) : na

    OrderBlock newOB = OrderBlock.new(obBox, mtLine)
    array.push(bearOBs, newOB)

    if array.size(bearOBs) > maxOBs
        OrderBlock oldOB = array.remove(bearOBs, 0)
        box.delete(oldOB.obBox)
        if not na(oldOB.mtLine)
            line.delete(oldOB.mtLine)

// Extend active Order Blocks & MT lines
if array.size(bullOBs) > 0
    for i = 0 to array.size(bullOBs) - 1
        OrderBlock item = array.get(bullOBs, i)
        box.set_right(item.obBox, bar_index + 5)
        if not na(item.mtLine)
            line.set_x2(item.mtLine, bar_index + 5)

if array.size(bearOBs) > 0
    for i = 0 to array.size(bearOBs) - 1
        OrderBlock item = array.get(bearOBs, i)
        box.set_right(item.obBox, bar_index + 5)
        if not na(item.mtLine)
            line.set_x2(item.mtLine, bar_index + 5)

// ============================================================================
// STEP 4: FAIR VALUE GAPS (FVG) & CONSEQUENT ENCROACHMENT (CE)
// ============================================================================

bool isBullFVG = showFVG and (low > high[2])
bool isBearFVG = showFVG and (high < low[2])

if isBullFVG
    float fvgTop = low
    float fvgBot = high[2]
    float ceLevel = (fvgTop + fvgBot) / 2.0

    box fvgBox = box.new(bar_index - 1, fvgTop, bar_index + 10, fvgBot, bgcolor=colBullFVG, border_color=color.new(colBullFVG, 0), border_style=line.style_dotted)
    line ceLine = showCE ? line.new(bar_index - 1, ceLevel, bar_index + 10, ceLevel, color=colCE, width=1, style=line.style_dotted) : na

    FairValueGap newFVG = FairValueGap.new(fvgBox, ceLine, fvgTop, fvgBot)
    array.push(bullFVGs, newFVG)

    if array.size(bullFVGs) > maxFVGs
        FairValueGap oldFVG = array.remove(bullFVGs, 0)
        box.delete(oldFVG.fvgBox)
        if not na(oldFVG.ceLine)
            line.delete(oldFVG.ceLine)

if isBearFVG
    float fvgTop = low[2]
    float fvgBot = high
    float ceLevel = (fvgTop + fvgBot) / 2.0

    box fvgBox = box.new(bar_index - 1, fvgTop, bar_index + 10, fvgBot, bgcolor=colBearFVG, border_color=color.new(colBearFVG, 0), border_style=line.style_dotted)
    line ceLine = showCE ? line.new(bar_index - 1, ceLevel, bar_index + 10, ceLevel, color=colCE, width=1, style=line.style_dotted) : na

    FairValueGap newFVG = FairValueGap.new(fvgBox, ceLine, fvgTop, fvgBot)
    array.push(bearFVGs, newFVG)

    if array.size(bearFVGs) > maxFVGs
        FairValueGap oldFVG = array.remove(bearFVGs, 0)
        box.delete(oldFVG.fvgBox)
        if not na(oldFVG.ceLine)
            line.delete(oldFVG.ceLine)

// Extend active FVGs & manage mitigation safely
if array.size(bullFVGs) > 0
    for i = array.size(bullFVGs) - 1 to 0 by -1
        FairValueGap item = array.get(bullFVGs, i)
        if filterMitigated and low < item.botVal
            box.delete(item.fvgBox)
            if not na(item.ceLine)
                line.delete(item.ceLine)
            array.remove(bullFVGs, i)
        else
            box.set_right(item.fvgBox, bar_index + 5)
            if not na(item.ceLine)
                line.set_x2(item.ceLine, bar_index + 5)

if array.size(bearFVGs) > 0
    for i = array.size(bearFVGs) - 1 to 0 by -1
        FairValueGap item = array.get(bearFVGs, i)
        if filterMitigated and high > item.topVal
            box.delete(item.fvgBox)
            if not na(item.ceLine)
                line.delete(item.ceLine)
            array.remove(bearFVGs, i)
        else
            box.set_right(item.fvgBox, bar_index + 5)
            if not na(item.ceLine)
                line.set_x2(item.ceLine, bar_index + 5)

// ============================================================================
// STEP 5: STATISTICS DASHBOARD
// ============================================================================

var table dashTable = table.new(position = dashPosition == "Top Right" ? position.top_right : dashPosition == "Bottom Right" ? position.bottom_right : dashPosition == "Top Left" ? position.top_left : position.bottom_left, columns = 2, rows = 6, bgcolor = color.new(color.black, 20), border_color = color.gray, border_width = 1)

if showDashboard and barstate.islast
    table.cell(dashTable, 0, 0, "Market Structure", bgcolor=color.new(#1e222d, 0), text_color=color.white, text_size=size.small)
    table.cell(dashTable, 1, 0, "Value / Status", bgcolor=color.new(#1e222d, 0), text_color=color.white, text_size=size.small)

    table.cell(dashTable, 0, 1, "Current Trend", text_color=color.white, text_size=size.small)
    table.cell(dashTable, 1, 1, marketTrend == 1 ? "BULLISH 🟢" : marketTrend == -1 ? "BEARISH 🔴" : "NEUTRAL ⚪", bgcolor=marketTrend == 1 ? color.new(color.green, 70) : marketTrend == -1 ? color.new(color.red, 70) : color.new(color.gray, 70), text_color=color.white, text_size=size.small)

    table.cell(dashTable, 0, 2, "Bullish BOS / CHoCH", text_color=color.white, text_size=size.small)
    table.cell(dashTable, 1, 2, str.tostring(countBullBOS) + " / " + str.tostring(countBullCHoCH), text_color=color.green, text_size=size.small)

    table.cell(dashTable, 0, 3, "Bearish BOS / CHoCH", text_color=color.white, text_size=size.small)
    table.cell(dashTable, 1, 3, str.tostring(countBearBOS) + " / " + str.tostring(countBearCHoCH), text_color=color.red, text_size=size.small)

    table.cell(dashTable, 0, 4, "Active Order Blocks", text_color=color.white, text_size=size.small)
    table.cell(dashTable, 1, 4, "Bull: " + str.tostring(array.size(bullOBs)) + " | Bear: " + str.tostring(array.size(bearOBs)), text_color=color.white, text_size=size.small)

    table.cell(dashTable, 0, 5, "Active FVGs (CE)", text_color=color.white, text_size=size.small)
    table.cell(dashTable, 1, 5, "Bull: " + str.tostring(array.size(bullFVGs)) + " | Bear: " + str.tostring(array.size(bearFVGs)), text_color=color.white, text_size=size.small)

// ============================================================================
// STEP 6: ALERT CONDITIONS
// ============================================================================

alertcondition(alertBullBOS, title="Bullish BOS", message="Market Structure: Bullish Break of Structure (BOS) confirmed on {{ticker}}.")
alertcondition(alertBearBOS, title="Bearish BOS", message="Market Structure: Bearish Break of Structure (BOS) confirmed on {{ticker}}.")
alertcondition(alertBullCHoCH, title="Bullish CHoCH", message="Market Structure: Bullish Change of Character (CHoCH) detected on {{ticker}}.")
alertcondition(alertBearCHoCH, title="Bearish CHoCH", message="Market Structure: Bearish Change of Character (CHoCH) detected on {{ticker}}.")
